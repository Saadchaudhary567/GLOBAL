rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() { return request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    match /siteContent/main { allow read: if true; allow create, update: if isAdmin(); allow delete: if false; }
    match /admins/{uid} { allow read: if request.auth != null && request.auth.uid == uid; allow create: if false; allow update, delete: if false; }
    match /products/{id} { allow read: if true; allow write: if isAdmin(); }
    match /categories/{id} { allow read: if true; allow write: if isAdmin(); }
    match /articles/{id} { allow read: if true; allow write: if isAdmin(); }
  }
}
